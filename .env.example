# ==========================================
# 1. REQUIRED FOR LOCAL DEVELOPMENT
# ==========================================
PORT=5000
NODE_ENV=development
FRONTEND_URI=http://localhost:3000

# ==========================================
# 2. REQUIRED FOR MONGODB
# ==========================================
# Your MongoDB connection string (Atlas replica set or local MongoDB URI)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority

# ==========================================
# 3. REQUIRED FOR BETTER AUTH & JWT VERIFICATION
# ==========================================
# Base URL where Better Auth endpoints and JWKS are served
BETTER_AUTH_URL=http://localhost:5000

# Random string used to sign session cookies and internal auth tokens (minimum 32 characters)
BETTER_AUTH_SECRET=your_better_auth_secret_minimum_32_characters_random_string

# ==========================================
# 4. REQUIRED FOR GOOGLE OAUTH
# ==========================================
# Obtained from Google Cloud Console > Credentials > OAuth 2.0 Client IDs (Web application)
# Authorized JavaScript Origins: http://localhost:3000, http://localhost:5000
# Authorized Redirect URI: http://localhost:5000/api/auth/callback/google
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# ==========================================
# 5. REQUIRED FOR PRODUCTION DEPLOYMENT
# ==========================================
# In production, update the URLs to your public domain names (with https://)
# PORT=80 or assigned by host (Vercel, Render, Railway, etc.)
# NODE_ENV=production
# FRONTEND_URI=https://your-frontend-domain.com
# BETTER_AUTH_URL=https://your-backend-api-domain.com

